# Copy to .env on the VPS and adjust for the compose runtime.
HOST_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json

# Rootless Podman maps container root to the host user, so 0:0 can write to
# host-owned bind mounts such as csv/<country>/outputs.
RUN_UID=0
RUN_GID=0

# Docker Engine users can switch back to their host UID/GID to avoid root-owned
# output files, for example RUN_UID=1000 and RUN_GID=1000.
